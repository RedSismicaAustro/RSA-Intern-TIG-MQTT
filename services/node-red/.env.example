# Entorno Node-RED
# ==============================================================================
# IMPORTANTE:
# 1. Copiar este archivo: cp .env.example .env
# 2. Rellenar con las credenciales reales
# 3. NUNCA commitear el archivo .env (está en .gitignore)

# MQTT Broker (VPS externo)
MQTT_BROKER=<IP_O_HOST_DEL_BROKER>
MQTT_USERNAME=<USUARIO_MQTT>
MQTT_PASSWORD=<PASSWORD_MQTT>
