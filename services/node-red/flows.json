    {
        "id": "node-parse-response",
        "type": "function",
        "z": "rsa-tab-control",
        "name": "Parse Response",
        "func": "// Extraer station_id del tópico MQTT\n// Formato: rsa/seismic/smart/{station_id}/cmd/extract_event/res\nconst parts = msg.topic.split('/');\nconst stationId = parts[3] || 'desconocida';\n\nconst response = msg.payload || {};\nconst status = response.status || 'unknown';\nconst requestId = response.request_id || 'N/A';\n\n// Timestamp en la zona horaria del proyecto\nconst now = new Date();\nconst timestamp = now.toLocaleString('es-EC', {\n    timeZone: 'America/Guayaquil',\n    hour12: false\n});\n\n// Ícono y color según estado\nconst icon = status === 'completed' ? '✅' : status === 'error' ? '❌' : '⚠️';\nconst color = status === 'completed' ? '#16a34a' : status === 'error' ? '#dc2626' : '#d97706';\n\n// Mensaje para la UI de texto\nconst logLine = `[${timestamp}] ${icon} ${stationId} — ${status.toUpperCase()} (req: ${requestId})`;\n\n// Recuperar historial y agregar nueva línea\nlet history = flow.get('responseHistory') || [];\nhistory.unshift(logLine); // Más reciente primero\nif (history.length > 50) history.pop(); // Límite de 50 entradas\nflow.set('responseHistory', history);\n\n// Salida 1: Notificación efímera (toast)\nconst notifMsg = {\n    payload: `${icon} <b>${stationId}</b>: ${status} — req: ${requestId}`,\n    color: color,\n    background: color,\n    border: color\n};\n\n// Salida 2: Historial limpio para el nodo template\nconst histMsg = {\n    payload: history.join('<br><br>')\n};\n\nreturn [notifMsg, histMsg];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 580,
        "wires": [
            [
                "node-ui-notification"
            ],
            [
                "94db4fbc4528f423"
            ]
        ]
    },
