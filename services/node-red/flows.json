    {
        "id": "node-send-button",
        "type": "ui_button",
        "z": "rsa-tab-control",
        "name": "Enviar Comando",
        "group": "rsa-ui-group-form",
        "order": 5,
        "width": "4",
        "height": "1",
        "passthru": false,
        "label": "🚀 Enviar Comando",
        "tooltip": "Publica el comando de extracción de evento en el broker MQTT",
        "color": "",
        "bgcolor": "#1d4ed8",
        "className": "",
        "icon": "",
        "payload": "send",
        "payloadType": "str",
        "topic": "",
        "topicType": "str",
        "x": 140,
        "y": 340,
        "wires": [["node-build-command"]]
    },
    {
        "id": "node-build-command",
        "type": "function",
        "z": "rsa-tab-control",
        "name": "Build Command",
        "func": "// Recuperar valores guardados en el contexto del flujo\nconst targetId = flow.get('targetId') || 'broadcast';\nconst startTime = flow.get('startTime');\nconst duration = flow.get('duration') || 30;\nconst upload = flow.get('upload') !== undefined ? flow.get('upload') : true;\n\n// Validación: Start Time es obligatorio\nif (!startTime) {\n    node.warn('⚠️ Start Time es obligatorio antes de enviar el comando');\n    return null;\n}\n\n// Formatear fecha al formato requerido: YYYY-MM-DDZHH:MM:SS\n// El formato ISO 8601 del date_picker es YYYY-MM-DDTHH:MM:SS\nconst dt = new Date(startTime);\nif (isNaN(dt.getTime())) {\n    node.warn('⚠️ Formato de fecha inválido: ' + startTime);\n    return null;\n}\n\nconst pad = (n) => String(n).padStart(2, '0');\nconst isoDate = `${dt.getFullYear()}-${pad(dt.getMonth()+1)}-${pad(dt.getDate())}Z${pad(dt.getHours())}:${pad(dt.getMinutes())}:${pad(dt.getSeconds())}`;\n\n// Generar request_id único (base36 del timestamp)\nconst requestId = 'evt-' + Date.now().toString(36);\n\n// Construir payload según el esquema definido\nmsg.payload = JSON.stringify({\n    start: isoDate,\n    duration: Number(duration),\n    upload: Boolean(upload),\n    request_id: requestId\n});\n\n// Definir tópico dinámicamente\nmsg.topic = `rsa/seismic/smart/${targetId}/cmd/extract_event`;\nmsg.qos = 1;\nmsg.retain = false;\n\nnode.log(`[RSA] Comando enviado → ${msg.topic} | req_id: ${requestId}`);\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 340,
        "wires": [["node-mqtt-out", "node-debug-out"]]
    },
    {
        "id": "node-mqtt-out",
        "type": "mqtt out",
        "z": "rsa-tab-control",
        "name": "MQTT Out → extract_event",
        "topic": "",
        "qos": "1",
        "retain": "false",
        "respTopic": "",
        "contentType": "",
        "userProps": "",
        "correl": "",
        "expiry": "",
        "broker": "rsa-mqtt-broker",
        "x": 600,
        "y": 340,
        "wires": []
    },
    {
        "id": "node-debug-out",
        "type": "debug",
        "z": "rsa-tab-control",
        "name": "Debug — Comando enviado",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "true",
        "targetType": "full",
        "statusVal": "",
        "statusType": "auto",
        "x": 620,
        "y": 400,
        "wires": []
    },
    {
        "id": "node-mqtt-in",
        "type": "mqtt in",
        "z": "rsa-tab-control",
        "name": "MQTT In ← Respuestas",
        "topic": "rsa/seismic/smart/+/cmd/extract_event/res",
        "qos": "1",
        "datatype": "json",
        "broker": "rsa-mqtt-broker",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 140,
        "y": 520,
        "wires": [["node-parse-response"]]
    },
    {
        "id": "node-parse-response",
        "type": "function",
        "z": "rsa-tab-control",
        "name": "Parse Response",
        "func": "// Extraer station_id del tópico MQTT\n// Formato: rsa/seismic/smart/{station_id}/cmd/extract_event/res\nconst parts = msg.topic.split('/');\nconst stationId = parts[3] || 'desconocida';\n\nconst response = msg.payload || {};\nconst status = response.status || 'unknown';\nconst requestId = response.request_id || 'N/A';\n\n// Timestamp en la zona horaria del proyecto\nconst now = new Date();\nconst timestamp = now.toLocaleString('es-EC', {\n    timeZone: 'America/Guayaquil',\n    hour12: false\n});\n\n// Ícono y color según estado\nconst icon = status === 'completed' ? '✅' : status === 'error' ? '❌' : '⚠️';\nconst color = status === 'completed' ? '#16a34a' : status === 'error' ? '#dc2626' : '#d97706';\n\n// Mensaje para la UI de texto\nconst logLine = `[${timestamp}] ${icon} ${stationId} — ${status.toUpperCase()} (req: ${requestId})`;\n\n// Recuperar historial y agregar nueva línea\nlet history = flow.get('responseHistory') || [];\nhistory.unshift(logLine); // Más reciente primero\nif (history.length > 50) history.pop(); // Límite de 50 entradas\nflow.set('responseHistory', history);\n\n// Salida 1: Notificación efímera (toast)\nconst notifMsg = {\n    payload: `${icon} <b>${stationId}</b>: ${status} — req: ${requestId}`,\n    color: color,\n    background: color,\n    border: color\n};\n\n// Salida 2: Historial de texto para el panel\nconst histMsg = {\n    payload: history.join('\\n')\n};\n\nreturn [notifMsg, histMsg];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 520,
        "wires": [
            ["node-ui-notification"],
            ["node-ui-log"]
        ]
    },
    {
        "id": "node-ui-notification",
        "type": "ui_toast",
        "z": "rsa-tab-control",
        "position": "top right",
        "displayTime": "5",
        "highlight": "",
        "sendall": true,
        "outputs": 0,
        "ok": "OK",
        "cancel": "",
        "raw": true,
        "className": "",
        "name": "Notificación de Respuesta",
        "x": 620,
        "y": 500,
        "wires": []
