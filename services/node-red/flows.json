    {
        "id": "94db4fbc4528f423",
        "type": "ui_template",
        "z": "rsa-tab-control",
        "group": "rsa-ui-group-log",
        "name": "Log de respuestas",
        "order": 1,
        "width": 10,
        "height": 11,
        "format": "<div\n    style=\"height: 100%; width: 100%; overflow-y: auto; text-align: left; padding: 10px; font-family: monospace; font-size: 13px; line-height: 1.5; box-sizing: border-box;\">\n    <span ng-bind-html=\"msg.payload\"></span>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
