    {
        "id": "node-build-command",
        "type": "function",
        "z": "rsa-tab-control",
        "name": "Build Command",
        "func": "// 1. Recuperar valores del contexto\nconst targetId = flow.get('targetId') || 'broadcast';\nconst startDate = flow.get('startDate'); \nconst startTime = flow.get('startTime'); // Texto \"HH:mm:ss\", \"HH:mm\" o milisegundos\nconst duration = flow.get('duration') || 30; \nconst timeMode = flow.get('timeMode') || 'LOCAL'; // 'LOCAL' (UTC-5) por defecto o 'UTC'\n\n// 2. Validaciones de seguridad\nif (!startDate || startTime === undefined || startTime === '') {\n    node.warn('⚠️ La Fecha y la Hora son obligatorias. Selecciónalas en el panel.');\n    return null;\n}\n\n// 3. Fusión de Fecha, Hora, Minutos y Segundos\nconst dt = new Date(startDate);\nlet hours = 0;\nlet minutes = 0;\nlet seconds = 0;\nif (typeof startTime === 'number') {\n    hours = Math.floor(startTime / 3600000);\n    minutes = Math.floor((startTime % 3600000) / 60000);\n    seconds = Math.floor((startTime % 60000) / 1000);\n} else if (typeof startTime === 'string' && startTime.includes(':')) {\n    const parts = startTime.trim().split(':');\n    hours = parseInt(parts[0], 10) || 0;\n    minutes = parseInt(parts[1], 10) || 0;\n    seconds = parseInt(parts[2], 10) || 0;\n} else {\n    node.warn('⚠️ Tipo o formato de dato de hora desconocido: ' + (typeof startTime) + ' -> ' + startTime);\n    return null;\n}\nif (hours < 0 || hours > 23 || minutes < 0 || minutes > 59 || seconds < 0 || seconds > 59) {\n    node.warn(`⚠️ Hora inválida ingresada: ${hours}:${minutes}:${seconds}. Las horas deben ser 0-23, minutos y segundos 0-59.`);\n    return null;\n}\n\n// 4. Formatear a YYYY-MM-DDZHH:MM:SS\nconst pad = (n) => String(n).padStart(2, '0');\nlet isoDate = '';\nlet cleanIsoUtc = '';\n\nif (timeMode === 'LOCAL') {\n    const year = dt.getFullYear();\n    const month = pad(dt.getMonth() + 1);\n    const day = pad(dt.getDate());\n    const hh = pad(hours);\n    const mm = pad(minutes);\n    const ss = pad(seconds);\n    const localIsoStr = `${year}-${month}-${day}T${hh}:${mm}:${ss}-05:00`;\n    const utcDt = new Date(localIsoStr);\n    const uY = utcDt.getUTCFullYear();\n    const uM = pad(utcDt.getUTCMonth() + 1);\n    const uD = pad(utcDt.getUTCDate());\n    const uh = pad(utcDt.getUTCHours());\n    const um = pad(utcDt.getUTCMinutes());\n    const us = pad(utcDt.getUTCSeconds());\n    isoDate = `${uY}-${uM}-${uD}Z${uh}:${um}:${us}`;\n    cleanIsoUtc = `${uY}-${uM}-${uD}T${uh}:${um}:${us}.000Z`;\n} else {\n    dt.setHours(hours);\n    dt.setMinutes(minutes);\n    dt.setSeconds(seconds);\n    const uY = dt.getFullYear();\n    const uM = pad(dt.getMonth() + 1);\n    const uD = pad(dt.getDate());\n    const uh = pad(dt.getHours());\n    const um = pad(dt.getMinutes());\n    const us = pad(dt.getSeconds());\n    isoDate = `${uY}-${uM}-${uD}Z${uh}:${um}:${us}`;\n    cleanIsoUtc = `${uY}-${uM}-${uD}T${uh}:${um}:${us}.000Z`;\n}\n\n// 5. Construcción de mensajes: comando para estaciones y metadatos para InfluxDB\nconst dateCompact = cleanIsoUtc.substring(0, 19).replace(/[-:]/g, '').replace('T', '-');\nconst requestId = 'man-' + dateCompact;\n\nmsg.payload = JSON.stringify({\n    start: isoDate,\n    duration: Number(duration),\n    upload: true,\n    delete_after_upload: true,\n    request_id: requestId\n});\nmsg.topic = `rsa/seismic/smart/${targetId}/cmd/extract_event`;\nmsg.qos = 1;\n\n// Metadatos para sincronización con InfluxDB vía Telegraf\nconst metaMsg = {\n    topic: 'rsa/seismic/smart/events/metadata',\n    qos: 1,\n    payload: JSON.stringify({\n        event_type: 'manual',\n        source: 'nodered',\n        event_id: requestId,\n        timestamp_utc: cleanIsoUtc,\n        stations: targetId === 'broadcast' ? 'ALL' : targetId,\n        n_stations: targetId === 'broadcast' ? 0 : 1,\n        duration_s: Number(duration),\n        request_id: requestId,\n        details: JSON.stringify({ target: targetId, trigger: 'nodered_ui' })\n    })\n};\n\nreturn [[msg, metaMsg], [msg]];\n",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 400,
        "wires": [
